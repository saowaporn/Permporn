# Add these privately in Vercel > Project > Settings > Environment Variables.
# Use the actual Google account that sends mail; the recipient stays fixed in code.
GOOGLE_MAIL_USER=contact@permporn-accessories.com
GOOGLE_APP_PASSWORD=
# Optional: use existing Google OAuth credentials instead of an App Password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated additional site origins, only if needed for a custom domain.
CONTACT_ALLOWED_ORIGINS=https://permporn-accessories.com,https://www.permporn-accessories.com
